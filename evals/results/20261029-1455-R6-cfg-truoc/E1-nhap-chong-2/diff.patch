-$('#import').onchange = async (e) => {
+// One import at a time: a file picked while another is still being read waits for it, so two confirmations never
+// overlap and each import sees the list the one before it left.
+let importing = Promise.resolve();
+
+$('#import').onchange = (e) => {
   const input = e.target;
   const file = input.files[0];
   input.value = ''; // so the same file can be picked again
   if (!file) return;
-  show(MESSAGES.reading);
-  const current = todos;
-  const result = await importBackup({ store, current, file, ask });
-  if (result.todos !== current) todos = result.todos;
-  show(result.message);
-  render();
+  importing = importing.catch(() => {}).then(async () => {
+    show(MESSAGES.reading);
+    // A function, not the list: importBackup reads it after the file, so todos added meanwhile count.
+    const result = await importBackup({ store, current: () => todos, file, ask });
+    todos = result.todos;
+    show(result.message);
+    render();
+  });
 };
 
 $('#unreadable').textContent = MESSAGES.unreadable;
