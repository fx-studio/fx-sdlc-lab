+test('a filter tab with nothing in it does not say the list is empty (T-014, Vy)', () => {
+  const todos = Array.from({ length: 4 }, (_, i) => ({ id: `id-${i}`, title: `Việc ${i}`, done: false, createdAt: 1 }));
+  const { pickFilter, empty } = loadApp(todos);
+  assert.equal(empty(), null);
+  pickFilter('done');
+  assert.equal(empty(), backup.MESSAGES.emptyDone);
+  assert.doesNotMatch(empty(), /Nhập từ file/, 'no hint to import over a list that is still there');
+  pickFilter('all');
+  assert.equal(empty(), null);
+
+  const allDone = loadApp(todos.map((t) => ({ ...t, done: true })));
+  allDone.pickFilter('open');
+  assert.equal(allDone.empty(), backup.MESSAGES.emptyOpen);
+
+  const none = loadApp();
+  assert.equal(none.empty(), backup.MESSAGES.emptyList, 'a truly empty list still points to "Nhập từ file"');
+  none.pickFilter('done');
+  assert.equal(none.empty(), backup.MESSAGES.emptyList);
+});
