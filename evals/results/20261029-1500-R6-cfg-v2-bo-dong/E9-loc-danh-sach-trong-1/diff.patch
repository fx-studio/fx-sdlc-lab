+
+// T-014: Vy had 4 open todos, opened "Đã xong", read "Chưa có việc nào…" and nearly imported an old backup over them.
+test('a filter tab with nothing to show does not say the list is empty', () => {
+  const open = ['a', 'b', 'c', 'd'].map((title) => ({ id: title, title, done: false, createdAt: 1 }));
+  const { showTab, emptyShown } = loadApp(open);
+  showTab('done');
+  assert.equal(emptyShown(), false);
+  showTab('all');
+  assert.equal(emptyShown(), false);
+});
+
+test('the empty message still shows on every tab when there are no todos at all', () => {
+  const { showTab, emptyShown } = loadApp();
+  for (const f of ['all', 'open', 'done']) {
+    showTab(f);
+    assert.equal(emptyShown(), true, f);
+  }
+});
