+test('empty filter tab: says the tab is empty, never the "list is empty, import a backup" sentence (Vy)', () => {
+  const todos = Array.from({ length: 4 }, (_, i) => ({ id: `id-${i}`, title: `Việc ${i}`, done: false, createdAt: 1 }));
+  const { tab, empty } = loadApp(todos);
+  assert.equal(empty(), null, '"Tất cả" with 4 todos shows no empty sentence');
+  tab('done');
+  assert.doesNotMatch(empty(), /Nhập từ file/);
+  assert.equal(empty(), backup.MESSAGES.emptyDone);
+  const allDone = loadApp(todos.map((t) => ({ ...t, done: true })));
+  allDone.tab('open');
+  assert.doesNotMatch(allDone.empty(), /Nhập từ file/);
+  assert.equal(allDone.empty(), backup.MESSAGES.emptyOpen);
+  const none = loadApp();
+  for (const f of ['all', 'open', 'done']) {
+    none.tab(f);
+    assert.equal(none.empty(), backup.MESSAGES.emptyList, `no todos at all, tab ${f}: the import hint stays`);
+  }
+});
