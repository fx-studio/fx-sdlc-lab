-$('#import').onchange = async (e) => {
+// Imports run one at a time: a file picked while another is still being read waits its turn, then decides (ask or not)
+// on the list as it is then, never on the list from when it was picked. So at most one confirm dialog is open.
+let importing = Promise.resolve();
+
+$('#import').onchange = (e) => {
   const input = e.target;
   const file = input.files[0];
   input.value = ''; // so the same file can be picked again
   if (!file) return;
   show(MESSAGES.reading);
-  const current = todos;
-  const result = await importBackup({ store, current, file, ask });
-  if (result.todos !== current) todos = result.todos;
-  show(result.message);
-  render();
+  const run = importing.then(async () => {
+    const result = await importBackup({ store, current: () => todos, file, ask });
+    todos = result.todos;
+    show(result.message);
+    render();
+  });
+  importing = run.catch(() => {}); // one failed import must not block the next
+  return run;
 };
 
 $('#unreadable').textContent = MESSAGES.unreadable;
