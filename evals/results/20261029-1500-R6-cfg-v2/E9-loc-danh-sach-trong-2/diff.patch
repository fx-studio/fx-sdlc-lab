+test('an empty filter tab does not say the list is empty or point to import (Vy, T-014)', () => {
+  const open = [1, 2, 3, 4].map((i) => ({ id: `id-${i}`, title: `Việc ${i}`, done: false, createdAt: 1 }));
+  const { filter, empty } = loadApp(open);
+  assert.equal(empty(), null);
+  filter('done');
+  assert.doesNotMatch(empty(), /Nhập từ file/);
+  assert.equal(empty(), backup.MESSAGES.emptyDone);
+  filter('all');
+  assert.equal(empty(), null);
+
+  const done = open.map((t) => ({ ...t, done: true }));
+  const app = loadApp(done);
+  app.filter('open');
+  assert.doesNotMatch(app.empty(), /Nhập từ file/);
+  assert.equal(app.empty(), backup.MESSAGES.emptyOpen);
+
+  const none = loadApp();
+  assert.equal(none.empty(), backup.MESSAGES.emptyList, 'a truly empty list still offers import');
+  none.filter('done');
+  assert.equal(none.empty(), backup.MESSAGES.emptyList);
