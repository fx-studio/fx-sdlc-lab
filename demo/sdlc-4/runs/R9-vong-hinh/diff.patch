diff --git a/app/style.css b/app/style.css
index 3cd635a..bf0c57a 100644
--- a/app/style.css
+++ b/app/style.css
@@ -2,8 +2,11 @@ body { font: 16px/1.5 system-ui, sans-serif; background: #f6f6f4; color: #222; m
 main { max-width: 32rem; margin: 3rem auto; padding: 0 1rem; }
