+function rename(id, title) {
+  const t = todos.find((x) => x.id === id);
+  if (!t) return render();
+  const old = t.title;
+  t.title = title.trim();
+  // A failed save keeps its own message; after a read error ('skipped') the banner already says nothing is saved.
+  if (commit().message || store.readError) return;
+  offerUndo(`Đã đổi tên thành “${t.title}”.`, () => {
+    // Looked up again: an import may have replaced the list, or the todo may be gone.
+    const now = todos.find((x) => x.id === id);
+    if (!now) return;
+    now.title = old;
+    commit();
+  });
+}
+
+// policy-ux#U2: an action on one item happens at once and offers Undo for 10 seconds. Any later message
+// (show() sets textContent) removes the button too.
+let undoTimer;
+function offerUndo(message, undo) {
+  show(message);
+  const button = document.createElement('button');
+  button.type = 'button';
+  button.textContent = 'Hoàn tác';
+  button.onclick = () => {
+    clearTimeout(undoTimer);
+    button.remove();
+    undo();
+  };
+  $('#message').append(' ', button);
+  clearTimeout(undoTimer);
+  undoTimer = setTimeout(() => button.remove(), 10000);
+}
+
 function remove(id) {
   todos = todos.filter((x) => x.id !== id);
   commit();
 }
 
 function commit() {
-  show(persist(store, todos).message);
+  const result = persist(store, todos);
+  show(result.message);
   render();
+  return result;
 }
 
