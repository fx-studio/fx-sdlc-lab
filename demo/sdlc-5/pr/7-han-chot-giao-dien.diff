+test('a redraw keeps keyboard focus on the same control of the same todo, also when Tab leaves a changed date (AC9, Q3)', () => {
+  const app = loadApp([dated('A', '2026-11-12'), dated('B', '2026-11-13')]);
+  app.dateField('B').focus();
+  app.ctx.render();
+  const field = app.dateField('B');
+  assert.equal(app.document.activeElement, field.el, 'the new date field of B');
+  field.change('2026-11-20');
+  const oldButton = app.row('B').children.button;
+  field.blur(oldButton); // Tab to the delete button of B
+  assert.notEqual(app.document.activeElement, oldButton, 'the list was redrawn');
+  assert.equal(app.document.activeElement, app.row('B').children.button, 'the delete button of B in the redrawn list');
+});
