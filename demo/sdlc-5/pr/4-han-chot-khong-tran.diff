@@ -0,0 +1,63 @@
+// Due dates: checking, today's date, overdue, display and sorting. No DOM and no browser storage here, so it can be tested
+// in Node. A due date is a calendar day 'YYYY-MM-DD' (not a moment in time); a todo without one has no dueDate key.
+// Never build a Date from a dueDate string (it is read as UTC) and never take the day from a UTC ISO string: both shift
+// the day at UTC+7.
+
+// New screen text (plan D1-D6, D8, D9). {title} is the todo's own title; fill it with a function replacer, as text only.
+const DUE_TEXT = {
+  label: 'Hạn chót',
+  rowLabel: 'Hạn chót của việc {title}',
+  due: 'Hạn {date}',
+  overdue: 'Quá hạn',
+  cleared: 'Đã bỏ hạn chót của việc {title}.',
+  undo: 'Hoàn tác',
+  sortBy: 'Xếp theo',
+  sortAdded: 'Thứ tự thêm',
+  sortDue: 'Hạn chót',
+  undone: 'Đã hoàn tác.',
+};
+
+// A string in the fixed form YYYY-MM-DD that is a real day (no 2026-02-30). Date.UTC and getUTC* do not depend on the time zone.
+function isValidDueDate(v) {
+  if (typeof v !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(v)) return false;
+  const [y, m, d] = v.split('-').map(Number);
+  const date = new Date(Date.UTC(y, m - 1, d));
+  return date.getUTCFullYear() === y && date.getUTCMonth() === m - 1 && date.getUTCDate() === d;
+}
+
+// The customer's own day on this machine (local time), as YYYY-MM-DD.
+function localDateString(date) {
+  const pad = (n) => String(n).padStart(2, '0');
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
+}
+
+// Open and due before today. Due today is not overdue; a done todo never is. The fixed 4-2-2 form compares as strings.
+function isOverdue(todo, today) {
+  return !todo.done && isValidDueDate(todo.dueDate) && todo.dueDate < today;
+}
+
+// 'Hạn DD/MM/YYYY'. Only for valid values.
+function formatDueDate(s) {
+  const [y, m, d] = s.split('-');
+  return DUE_TEXT.due.replace('{date}', `${d}/${m}/${y}`);
+}
+
+// A new array (the stored order is never changed): valid dates ascending, then todos with no or a broken dueDate.
+// Ties keep the given order, by comparing the original index rather than relying on a stable sort.
+function sortByDue(todos) {
+  return todos
+    .map((todo, index) => ({ todo, index, key: isValidDueDate(todo.dueDate) ? todo.dueDate : null }))
+    .sort((a, b) => {
+      if (a.key !== b.key) {
+        if (a.key === null) return 1;
+        if (b.key === null) return -1;
+        return a.key < b.key ? -1 : 1;
+      }
+      return a.index - b.index;
+    })
+    .map((x) => x.todo);
+}
+
+if (typeof module !== 'undefined') {
+  module.exports = { DUE_TEXT, isValidDueDate, localDateString, isOverdue, formatDueDate, sortByDue };
+}
