+  assert.equal(isOverdue(todo('a', { dueDate: '2026-12-31' }), '2027-01-01'), true);
+  assert.equal(isOverdue(todo('b', { dueDate: '2026-10-31' }), '2026-11-01'), true);
+  assert.equal(isOverdue(todo('c', { dueDate: '2027-01-01' }), '2026-12-31'), false);
+});
+
+test('A14: isOverdue does not change the todo', () => {
+  const t = todo('a', { dueDate: 'abc' });
+  const before = { ...t };
+  isOverdue(t, TODAY);
+  assert.deepEqual(t, before);
+});
+
+// ---- formatDueDate (AC1, A5) ----
+
+test('AC1/A5: formatDueDate shows "Hạn DD/MM/YYYY"', () => {
+  assert.equal(formatDueDate('2026-11-12'), 'Hạn 12/11/2026');
+  assert.equal(formatDueDate('2026-10-25'), 'Hạn 25/10/2026');
+});
+
+test('A5: formatDueDate keeps two-digit day and month', () => {
+  // AMBIGUOUS: spec gives the pattern DD/MM/YYYY but its examples have no single-digit day or month; reading DD/MM as zero-padded.
+  assert.equal(formatDueDate('2026-01-05'), 'Hạn 05/01/2026');
+});
+
+test('A9/A15: formatDueDate does not shift the day by time zone', () => {
+  // At +7, local midnight is 17:00 UTC the day before, so a path through toISOString() shows the previous day.
+  assert.equal(formatDueDate('2026-11-01'), 'Hạn 01/11/2026');
+  assert.equal(formatDueDate('2027-01-01'), 'Hạn 01/01/2027');
+  assert.equal(formatDueDate('2026-12-31'), 'Hạn 31/12/2026');
+});
+
+test('D3: formatDueDate matches the DUE_TEXT.due template', () => {
+  assert.equal(formatDueDate('2026-11-12'), DUE_TEXT.due.replace('{date}', '12/11/2026'));
+});
+
+// ---- sortByDue (AC4, AC5, AC8, A12, A13, Q6) ----
+
+test('AC4/A12: sort by due puts earlier dates first, ties keep added order, no due date last', () => {
+  const list = [todo('A'), todo('B', { dueDate: '2026-11-15' }), todo('C', { dueDate: '2026-11-12' }), todo('D', { dueDate: '2026-11-12' })];
+  assert.deepEqual(titles(sortByDue(list)), ['C', 'D', 'B', 'A']);
+});
+
+test('AC4/Q6: sortByDue returns a new array and does not reorder or change the input', () => {
+  const list = [todo('A'), todo('B', { dueDate: '2026-11-15' }), todo('C', { dueDate: '2026-11-12' }), todo('D', { dueDate: '2026-11-12' })];
+  const snapshot = structuredClone(list);
+  const out = sortByDue(list);
+  assert.notEqual(out, list);
+  assert.deepEqual(list, snapshot);
+  assert.deepEqual(titles(list), ['A', 'B', 'C', 'D']);
+});
+
+test('AC8/A14: broken dueDate values sort last, like no due date, in added order', () => {
+  // AMBIGUOUS: spec says broken values "sort like no due date"; reading missing and broken as one group kept in added order.
+  const list = [
+    todo('P', { dueDate: 'abc' }),
+    todo('Q'),
+    todo('R', { dueDate: '2026-11-20' }),
+    todo('S', { dueDate: '2026-02-30' }),
+    todo('T', { dueDate: null }),
+    todo('U', { dueDate: '2026-11-11' }),
+  ];
+  assert.deepEqual(titles(sortByDue(list)), ['U', 'R', 'P', 'Q', 'S', 'T']);
+});
+
+test('AC8/A14: sortByDue keeps broken values unchanged on the todos', () => {
+  const list = [todo('P', { dueDate: 'abc' }), todo('S', { dueDate: '2026-02-30' })];
+  const out = sortByDue(list);
+  assert.equal(out.find((t) => t.title === 'P').dueDate, 'abc');
+  assert.equal(out.find((t) => t.title === 'S').dueDate, '2026-02-30');
+});
+
+test('A13: sort by due with no due dates at all shows added order', () => {
+  const list = [todo('A'), todo('B'), todo('C')];
+  assert.deepEqual(titles(sortByDue(list)), ['A', 'B', 'C']);
+  assert.deepEqual(sortByDue([]), []);
+});
+
+test('A12: ties keep added order on a long list', () => {
+  const list = Array.from({ length: 30 }, (_, i) => todo(`T${i}`, { dueDate: '2026-11-12' }));
+  assert.deepEqual(titles(sortByDue(list)), titles(list));
+});
+
+test('F4 step 3: sort compares across months and years', () => {
+  const list = [todo('Y27', { dueDate: '2027-01-01' }), todo('D26', { dueDate: '2026-12-01' }), todo('N26', { dueDate: '2026-11-30' })];
+  assert.deepEqual(titles(sortByDue(list)), ['N26', 'D26', 'Y27']);
+});
+
+test('AC5/F4 step 4: sortByDue works on a filtered list (not done only) and ignores done state', () => {
+  const all = [
+    todo('A'),
+    todo('B', { dueDate: '2026-11-15' }),
+    todo('X', { dueDate: '2026-11-01', done: true }),
+    todo('C', { dueDate: '2026-11-12' }),
+  ];
+  const notDone = all.filter((t) => !t.done);
+  assert.deepEqual(titles(sortByDue(notDone)), ['C', 'B', 'A']);
+  // Done todos are sorted by date like the others (the filter decides what shows).
+  assert.deepEqual(titles(sortByDue(all)), ['X', 'C', 'B', 'A']);
+});
+
+test('Q6: sortByDue returns the same todo objects (only order changes)', () => {
+  // AMBIGUOUS: spec only says sorting changes the shown order, not stored data; reading that as no copying or rewriting of todos.
+  const list = [todo('A'), todo('B', { dueDate: '2026-11-15' })];
+  const out = sortByDue(list);
+  assert.equal(out.length, 2);
+  assert.ok(out.every((t) => list.includes(t)));
+});
+
+// ---- DUE_TEXT (AC9, AC10, U4, D1-D6, D8, D9) ----
+
+const EXPECTED_TEXT = {
+  label: 'Hạn chót',
+  rowLabel: 'Hạn chót của việc {title}',
+  due: 'Hạn {date}',
+  overdue: 'Quá hạn',
+  cleared: 'Đã bỏ hạn chót của việc {title}.',
+  undo: 'Hoàn tác',
+  sortBy: 'Xếp theo',
+  sortAdded: 'Thứ tự thêm',
+  sortDue: 'Hạn chót',
+  undone: 'Đã hoàn tác.',
+};
+
+test('D1-D6, D8, D9: DUE_TEXT has the chosen wording verbatim', () => {
+  for (const [key, value] of Object.entries(EXPECTED_TEXT)) {
+    assert.equal(DUE_TEXT[key], value, key);
+  }
+});
+
+test('AC10/U4: no DUE_TEXT value contains localStorage, JSON, console or dueDate', () => {
+  const values = Object.values(DUE_TEXT);
+  assert.ok(values.length >= Object.keys(EXPECTED_TEXT).length);
+  for (const v of values) {
+    assert.equal(typeof v, 'string');
+    // Case-insensitive: stricter than the spec, which lists the words as written.
+    for (const word of ['localstorage', 'json', 'console', 'duedate']) {
+      assert.ok(!v.toLowerCase().includes(word), `${JSON.stringify(v)} contains ${word}`);
+    }
+  }
+});
+
+test('AC12/A16: D2 and D5 keep a title verbatim when filled', () => {
+  const title = '<img src=x onerror=alert(1)>';
+  assert.equal(DUE_TEXT.rowLabel.replace('{title}', title), `Hạn chót của việc ${title}`);
+  assert.equal(DUE_TEXT.cleared.replace('{title}', title), `Đã bỏ hạn chót của việc ${title}.`);
+});
