+// Due dates (plan/2026-10-19-han-chot-cho-viec.md, Q2). No DOM and no browser storage here, so this file can be tested in Node.
+// A due date is a string YYYY-MM-DD on the todo (key `dueDate`, absent when there is none). "Today" is the machine's own day
+// (local time), never the UTC day: no toISOString and no Date built from a due date string except through Date.UTC below.
+
+// Every new sentence and label of the due date feature (plan, Câu chữ). {title} is filled by the caller, {date} by formatDueDate.
+const DUE_TEXT = {
+  addLabel: 'Hạn chót', // D1
+  rowLabel: 'Hạn chót của việc {title}', // D2
+  dueOn: 'Hạn {date}', // D3
+  overdue: 'Quá hạn', // D4
+  cleared: 'Đã bỏ hạn chót của việc {title}.', // D5
+  undo: 'Hoàn tác', // D6
+  sortLabel: 'Xếp theo', // D8
+  sortAdded: 'Thứ tự thêm', // D8
+  sortDue: 'Hạn chót', // D8
+  undone: 'Đã hoàn tác.', // D9
+};
+
+// A string in the fixed form YYYY-MM-DD that is a real day (no 2026-02-30). Date.UTC + getUTC* so the time zone plays no part.
+function isValidDueDate(v) {
+  if (typeof v !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(v)) return false;
+  const [y, m, d] = v.split('-').map(Number);
+  const date = new Date(Date.UTC(y, m - 1, d));
+  return date.getUTCFullYear() === y && date.getUTCMonth() === m - 1 && date.getUTCDate() === d;
+}
+
+// The machine's own day as YYYY-MM-DD (A9).
+function localDateString(date) {
+  const pad = (n) => String(n).padStart(2, '0');
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
+}
+
+// today is localDateString(new Date()). Comparing strings works because the form is fixed (4-2-2 digits).
+// Due today is not overdue (A6); a done todo never is (A7); a broken value counts as no due date (A14).
+function isOverdue(todo, today) {
+  return !todo.done && isValidDueDate(todo.dueDate) && todo.dueDate < today;
+}
+
+// "Hạn DD/MM/YYYY" (A5). Only call it with a valid due date.
+function formatDueDate(s) {
+  const [y, m, d] = s.split('-');
+  return DUE_TEXT.dueOn.replace('{date}', `${d}/${m}/${y}`);
+}
+
+// A new array (the saved list keeps its added order, Q6): valid dates earliest first, then todos with no due date or a broken
+// one. Ties keep the original order, by index, without relying on sort stability (A12).
+function sortByDue(todos) {
+  const key = (t) => (isValidDueDate(t.dueDate) ? t.dueDate : null);
+  return todos
+    .map((t, i) => ({ t, i, k: key(t) }))
+    .sort((a, b) => {
+      if (a.k !== b.k) {
+        if (a.k === null) return 1;
+        if (b.k === null) return -1;
+        return a.k < b.k ? -1 : 1;
+      }
+      return a.i - b.i;
+    })
+    .map((x) => x.t);
+}
+
+if (typeof module !== 'undefined') {
+  module.exports = { DUE_TEXT, isValidDueDate, localDateString, isOverdue, formatDueDate, sortByDue };
+}
