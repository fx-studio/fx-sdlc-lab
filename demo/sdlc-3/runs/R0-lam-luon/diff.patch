 const store = {
+  // Returns { ok: true, todos } or { ok: false } when the saved list cannot be read.
+  // No key yet is a normal empty list. A value that does not parse, is not an array, or storage that throws is a read error:
+  // the caller must not overwrite it.
   load() {
+    let raw;
     try {
-      return JSON.parse(localStorage.getItem(STORE_KEY)) || [];
+      raw = localStorage.getItem(STORE_KEY);
     } catch {
-      return [];
+      return { ok: false };
     }
+    if (raw === null) return { ok: true, todos: [] };
+    let todos;
+    try {
+      todos = JSON.parse(raw);
+    } catch {
+      return { ok: false };
+    }
+    return Array.isArray(todos) ? { ok: true, todos } : { ok: false };
   },
+  // Returns true on success, false when the write fails (localStorage is capped per origin, about 5 MB in most browsers).
