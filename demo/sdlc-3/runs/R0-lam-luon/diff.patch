+  if (!isPlainObject(data) || !hasExactKeys(data, ['version', 'todos']) || data.version !== 1 || !Array.isArray(data.todos)) {
+    return 'not-backup';
+  }
+  if (data.todos.length === 0) return 'empty';
+  const ids = new Set();
+  for (const t of data.todos) {
+    if (!isPlainObject(t) || !hasExactKeys(t, FIELDS)) return 'not-backup';
+    if (typeof t.id !== 'string' || typeof t.title !== 'string' || typeof t.done !== 'boolean') return 'not-backup';
+    if (typeof t.createdAt !== 'number' || !Number.isFinite(t.createdAt)) return 'damaged';
+    if (t.id === '' || ids.has(t.id) || t.title.trim() === '') return 'damaged';
+    ids.add(t.id);
+  }
+  return data.todos.map((t) => ({ id: t.id, title: t.title, done: t.done, createdAt: t.createdAt }));
+}
+
+const KEEP = 'Danh sách của bạn vẫn giữ nguyên.';
+const REJECTED = {
