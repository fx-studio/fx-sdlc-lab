+  });
+}
+
+async function importFile(file) {
+  if (file.size > MAX_IMPORT_BYTES) {
+    showMessage(REJECTED['too-big'], true);
+    return;
+  }
+  showMessage('Đang đọc file…');
+  let text;
+  try {
+    text = await file.text();
+  } catch {
+    showMessage(REJECTED.unreadable, true);
+    return;
+  }
+  const imported = parseBackup(text);
+  if (typeof imported === 'string') {
+    showMessage(REJECTED[imported], true);
+    return;
+  }
+  const question = confirmText(imported.length);
+  if (question && !(await askConfirm(question))) {
+    showMessage('');
+    return;
+  }
+  // The only write allowed while the saved list is unreadable. On failure the old list stays on screen and in memory.
+  if (!store.save(imported)) {
+    saveFailed = true;
+    showMessage(SAVE_FAILED, true);
+    return;
+  }
+  todos = imported;
+  loadFailed = false;
+  saveFailed = false;
+  showMessage(`Đã nhập ${imported.length} việc.`);
+  render();
 }
 
