+  'damaged': `File sao lưu này bị lỗi (có việc trùng nhau, thiếu tiêu đề hoặc sai ngày tạo) nên không nhập được. ${KEEP} Hãy chọn một file sao lưu khác.`,
+  'empty': `File sao lưu này không có việc nào nên không nhập. ${KEEP}`,
+};
+
+function confirmText(count) {
+  if (loadFailed && todos.length === 0) return `Thay danh sách đã lưu không đọc được bằng ${count} việc trong file?`;
+  if (loadFailed) return `Thay danh sách đã lưu không đọc được và ${todos.length} việc bạn vừa thêm (chưa lưu) bằng ${count} việc trong file?`;
+  if (todos.length > 0) return `Thay ${todos.length} việc hiện có bằng ${count} việc trong file?`;
+  return null; // empty list: nothing is lost, no confirmation (policy-security S2)
+}
+
+function askConfirm(text) {
+  const dialog = $('#confirm');
+  $('#confirm-text').textContent = text;
+  dialog.returnValue = '';
